{"norms":[{"id":"us-const-art1-s8-cl1","corpus":"us-const","side":"us","lang":"en","kind":"article","num":"U.S. Const. Art. I, § 8, cl. 1","heading":"Spending Clause (Taxing and Spending Power)","path":[{"label":"Constitution of the United States"}],"text":"The Congress shall have Power To lay and collect Taxes, Duties, Imposts and Excises, to pay the Debts and provide for the common Defence and general Welfare of the United States; but all Duties, Imposts and Excises shall be uniform throughout the United States;","in_force_since":"1789-03-04","status":"in force","applies_to":["US"],"official_url":"https://constitution.congress.gov/browse/article-1/section-8/clause-1/","alt_urls":[{"label":"National Archives transcription","url":"https://www.archives.gov/founding-docs/constitution-transcript"}],"source_ids":{"const":"Art. I, § 8, cl. 1","text_sha1":"bc37e8b40efe858e82ee5e087359b42b3528aecc"},"d_method":"entry into force of the Constitution (1789-03-04) / ratification of the amendment; never amended","issues":["us.support.title-iv-d","us.constitution.federalism"],"xrefs":[],"interps":["us-ca8-809-f2d-508"],"axes":["family"],"outside":[{"engine":"courtlistener","label_fr":"CourtListener — Cour suprême des États-Unis et 8e circuit","label_en":"CourtListener — U.S. Supreme Court & Eighth Circuit","url":"https://www.courtlistener.com/?q=%22U.S.%20Const.%20Art.%20I%2C%20%C2%A7%208%2C%20cl.%201%22&type=o&court=scotus%20ca8","note_fr":"","note_en":"","manual":false},{"engine":"justia","label_fr":"Justia (recherche générale)","label_en":"Justia (site search)","url":"https://www.justia.com/search?q=%22U.S.%20Const.%20Art.%20I%2C%20%C2%A7%208%2C%20cl.%201%22","note_fr":"","note_en":"","manual":false}],"outside_q":"\"U.S. Const. Art. I, § 8, cl. 1\"","propose_url":"https://github.com/vagabondo73/family-law-fr-us-annotated-browser/issues/new?template=proposal.yml&labels=proposal%2Cneeds-screening&title=%5BProposal%5D%20us-const-art1-s8-cl1%20%E2%80%94%20&norm_id=us-const-art1-s8-cl1&norm_page=https%3A%2F%2Fvagabondo73.github.io%2Ffamily-law-fr-us-annotated-browser%2Fcontent%2Fus-const-art1-s8-cl1.html"},{"id":"us-const-art2-s2-cl2","corpus":"us-const","side":"us","lang":"en","kind":"article","num":"U.S. Const. Art. II, § 2, cl. 2","heading":"Treaty Clause","path":[{"label":"Constitution of the United States"}],"text":"He shall have Power, by and with the Advice and Consent of the Senate, to make Treaties, provided two thirds of the Senators present concur; and he shall nominate, and by and with the Advice and Consent of the Senate, shall appoint Ambassadors, other public Ministers and Consuls, Judges of the supreme Court, and all other Officers of the United States, whose Appointments are not herein otherwise provided for, and which shall be established by Law: but the Congress may by Law vest the Appointment of such inferior Officers, as they think proper, in the President alone, in the Courts of Law, or in the Heads of Departments.","in_force_since":"1789-03-04","status":"in force","applies_to":["US"],"official_url":"https://constitution.congress.gov/browse/article-2/section-2/clause-2/","alt_urls":[{"label":"National Archives transcription","url":"https://www.archives.gov/founding-docs/constitution-transcript"}],"source_ids":{"const":"Art. II, § 2, cl. 2","text_sha1":"412947b484bf3de129b4444bf2756e84ac2a0df1"},"d_method":"entry into force of the Constitution (1789-03-04) / ratification of the amendment; never amended","issues":["us.constitution.treaties"],"xrefs":[],"interps":[],"axes":["family"],"outside":[{"engine":"courtlistener","label_fr":"CourtListener — Cour suprême des États-Unis et 8e circuit","label_en":"CourtListener — U.S. Supreme Court & Eighth Circuit","url":"https://www.courtlistener.com/?q=%22U.S.%20Const.%20Art.%20II%2C%20%C2%A7%202%2C%20cl.%202%22&type=o&court=scotus%20ca8","note_fr":"","note_en":"","manual":false},{"engine":"justia","label_fr":"Justia (recherche générale)","label_en":"Justia (site search)","url":"htt